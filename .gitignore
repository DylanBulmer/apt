# Cargo build output. mc/Cargo.lock IS tracked: these crates ship as binaries,
# and a reproducible .deb means pinning the whole dependency graph, not just the
# direct requirements.
mc/target/

# Built packages and staging trees
mc/dist/
mc/staging/

# reprepro state (generated, not source-controlled)
apt/db/
apt/dists/
apt/pool/

# NEVER commit the GPG private key — use a GitHub Actions secret instead.
# Export with: gpg --armor --export-secret-key KEY_ID | base64
# The PUBLIC key (apt/bulmer.asc) is intentionally tracked.
*.secret.asc
*.private.asc
private-key.*
secring.*

# Editor cruft
.vscode/
*.swp
*~
