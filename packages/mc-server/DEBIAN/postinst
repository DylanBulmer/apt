#!/bin/bash
set -e

MC_USER="minecraft"
MC_BASE="/opt/minecraft"
MC_BACKUP="/var/backups/minecraft"
MC_CONFIG="/etc/minecraft"

case "$1" in
    configure)
        # Create minecraft system group and user if they don't exist
        if ! getent group "$MC_USER" &>/dev/null; then
            groupadd --system "$MC_USER"
        fi
        if ! id "$MC_USER" &>/dev/null; then
            useradd --system \
                --gid "$MC_USER" \
                --home-dir "$MC_BASE" \
                --shell /usr/sbin/nologin \
                --comment "Minecraft server manager" \
                "$MC_USER"
        fi

        # Server data dir: owned by the service account, but NOT world-readable
        # — server.properties inside it carries the RCON password.
        mkdir -p "$MC_BASE"
        chown "$MC_USER:$MC_USER" "$MC_BASE"
        chmod 750 "$MC_BASE"

        # Backup dir: root-only. Backups are written by root and read only by
        # root (`mc restore`). It must not be owned or writable by $MC_USER —
        # that account is the one exposed to untrusted mods and plugins, and
        # owning this directory would let it (a) pre-create the next predictable
        # backup filename as a symlink for root's tar to follow, and (b) swap an
        # archive between `mc restore`'s validation pass and its extraction.
        mkdir -p "$MC_BACKUP"
        chown root:root "$MC_BACKUP"
        chmod 700 "$MC_BACKUP"

        # Assert owner AND mode on an existing server.properties. 0644 leaves the
        # RCON password readable by every local user; root-owned 0640 is worse,
        # because the JVM runs as $MC_USER and can then neither read nor write
        # it, so the server comes up on compiled-in defaults instead of its own
        # config. Editing the file as root with a write-and-rename editor
        # (`sed -i`, some vim configs) produces exactly that, which is why this
        # runs on every configure rather than only on upgrades.
        if [[ -f "$MC_BASE/server.properties" ]]; then
            chown "$MC_USER:$MC_USER" "$MC_BASE/server.properties"
            chmod 640 "$MC_BASE/server.properties"
        fi

        # Config dir: root-owned, world-readable
        mkdir -p "$MC_CONFIG"
        chown root:root "$MC_CONFIG"
        chmod 755 "$MC_CONFIG"

        # Ensure new scripts are executable
        for script in /usr/lib/mc/start.sh /usr/lib/mc/stop.sh /usr/lib/mc/reload.sh; do
            [[ -f "$script" ]] && chmod 755 "$script"
        done

        # Reload systemd so the unit files this package just replaced take
        # effect, then make sure the backup timer is running.
        #
        # GATED ON /run/systemd/system, the canonical "systemd is the running
        # init" test, and what dh_installsystemd generates.
        #
        # Do NOT gate on `systemctl is-system-running`: that is a HEALTH check,
        # not a presence check. It succeeds only for the exact state "running"
        # and returns non-zero for "degraded" — any machine with one failed unit,
        # related or not — which would skip the reload and the timer setup. If
        # minecraft.service were the failed unit that becomes self-sustaining:
        # the system stays degraded, every later upgrade skips the reload, and
        # systemd keeps warning that the unit changed on disk.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true

            # Enable and start the backup timer
            systemctl enable minecraft-backup.timer || true
            systemctl start  minecraft-backup.timer 2>/dev/null || true
        fi

        # NOT restarted here, deliberately. daemon-reload clears the warning and
        # makes the new unit authoritative for the next start; a running server
        # keeps the old one until it is restarted. Restarting on the operator's
        # behalf during an unattended `apt upgrade` would drop players — and on
        # a populated server stop.sh spends five minutes counting them down
        # first. Restart when you choose to: mc restart
        ;;
esac

exit 0
