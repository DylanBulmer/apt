#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/usr/lib/mc/lib.sh
source /usr/lib/mc/lib.sh

# Load installed command plugins (e.g. mc-rcon adds 'rcon')
for _plugin in /usr/lib/mc/commands.d/*.sh; do
    [[ -f "$_plugin" ]] && source "$_plugin"
done
unset _plugin

# Kept intact for mc_elevate, which re-runs this invocation under sudo. By the
# time a guard inside a cmd_* decides root is needed, the command's own option
# parsing has consumed the arguments, and $@ no longer describes what was typed.
_MC_ARGV=("$@")

_MC_CMD="${1:-help}"
shift || true

case "$_MC_CMD" in
    install) cmd_install  "$@" ;;
    upgrade) cmd_upgrade  "$@" ;;
    start)   cmd_start    "$@" ;;
    stop)    cmd_stop         ;;
    restart) cmd_restart  "$@" ;;
    status)  cmd_status       ;;
    backup)  cmd_backup       ;;
    restore) cmd_restore  "$@" ;;
    logs)    cmd_logs         ;;
    delete)  cmd_delete       ;;
    help|--help|-h) usage ;;
    *)
        # Only names a plugin explicitly registered via mc_register_command are
        # dispatchable. Resolving to a cmd_* function is necessary but NOT
        # sufficient — otherwise internal helpers (cmd_install_mrpack, ...) would
        # be callable directly, skipping the require_root/acquire_lock/load_config
        # their real entry points perform.
        if mc_is_plugin_command "$_MC_CMD" && declare -f "cmd_${_MC_CMD}" >/dev/null 2>&1; then
            "cmd_${_MC_CMD}" "$@"
        else
            error "Unknown command: $_MC_CMD"
            usage
            exit 1
        fi
        ;;
esac
