# bash completion for mc (mc-server / mc-rcon)

_mc() {
    local cur prev words cword
    _init_completion || return

    local commands="install upgrade start stop restart status backup restore logs delete help"

    # Pick up plugin-provided commands (e.g. mc-rcon adds 'rcon') the same way
    # /usr/bin/mc does: source-scanning /usr/lib/mc/commands.d/*.sh for cmd_*.
    local plugin_dir="/usr/lib/mc/commands.d" f
    if [[ -d "$plugin_dir" ]]; then
        for f in "$plugin_dir"/*.sh; do
            [[ -f "$f" ]] || continue
            commands+=" $(grep -Eo '^cmd_[A-Za-z0-9_]+' "$f" | sed 's/^cmd_//')"
        done
    fi

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return
    fi

    case "${words[1]}" in
        install|upgrade)
            case "$prev" in
                --type)
                    COMPREPLY=( $(compgen -W "vanilla paper fabric neoforge" -- "$cur") )
                    return
                    ;;
                --version)
                    return
                    ;;
            esac
            COMPREPLY=( $(compgen -W "--type --version --yes -y" -- "$cur")
                        $(compgen -f -X '!*.mrpack' -- "$cur") )
            ;;
        restore)
            local backups=()
            if [[ -d /var/backups/minecraft ]]; then
                backups=(/var/backups/minecraft/minecraft-*.tar.gz)
                [[ -e ${backups[0]} ]] || backups=()
            fi
            COMPREPLY=( $(compgen -W "${backups[*]}" -- "$cur") )
            ;;
    esac
} &&
    complete -F _mc mc
