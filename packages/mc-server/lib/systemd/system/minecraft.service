[Unit]
Description=Minecraft Server
After=network.target
Documentation=https://apt.bulmer.dev

# Bound on Restart=on-failure below. A server that crashes during startup — a
# broken mod, a corrupt level.dat, an out-of-memory heap size — fails the same
# way every time, and retrying it every RestartSec forever leaves the unit
# permanently "activating" while never reaching a state anything can alert on.
# After 5 failures in an hour systemd stops retrying and the unit sits in
# `failed`, which is the honest answer. Occasional unrelated crashes stay well
# inside the window and still recover automatically.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft

# ── Hardening ──────────────────────────────────────────────────────────────
# The server already runs as the unprivileged 'minecraft' user (above). These
# directives stop a compromised JVM or mod from regaining privileges or
# touching anything outside the server's own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/minecraft
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NOTE: MemoryDenyWriteExecute is intentionally omitted — the JVM's JIT needs
# writable+executable pages and would fail to start under it.

# There is deliberately no StandardInput= here, and adding one will not help:
# every value systemd offers either hands the JVM an immediate EOF (null, the
# default, and data/file) or needs a terminal or socket this unit does not have.
# The server console treats EOF on stdin as a shutdown request, so start.sh
# builds a read-write FIFO and hands that to the JVM instead. See the "Console
# stdin" section there before changing anything about stdin.
ExecStart=/usr/lib/mc/start.sh
ExecStop=/usr/lib/mc/stop.sh
ExecReload=/usr/lib/mc/reload.sh

# Outer bound on the whole stop procedure (ExecStop + SIGTERM) before systemd
# sends SIGKILL. Derived from the worst-case path through stop.sh — the
# 5-minute tier, taken whenever at least one player is online OR the player
# count cannot be determined (everything except a provably empty server):
#
#   list query           15 s   (RCON_CMD_TIMEOUT)
#   countdown 300 180 60
#     sleeps             300 s  (120 + 120 + 60)
#     3x say announce     15 s  (3 x RCON_SAY_TIMEOUT, worst case)
#   stop command         15 s   (RCON_CMD_TIMEOUT)
#   chunk-flush sleep     10 s
#   ------------------------------
#   worst case           355 s
#   safety buffer         20 s
#   ------------------------------
#   TimeoutStopSec       375 s
#
# On a healthy server the RCON calls are sub-millisecond, so the real elapsed
# time is ~310 s and the JVM gets ~65 s after SIGTERM to finish exiting.
#
# If you change RCON_SAY_TIMEOUT / RCON_CMD_TIMEOUT or the countdown tiers in
# stop.sh, recompute this value.
TimeoutStopSec=375s
TimeoutStartSec=60s

# Only kill the main process; ExecStop handles the rest.
KillMode=process

# ── Failure reporting ──────────────────────────────────────────────────────
# There is deliberately NO SuccessExitStatus= here. It used to read
# "SuccessExitStatus=0 1", which existed so that start.sh's config refusals
# (EULA not accepted, and now an unreadable server.properties or a missing
# server.jar) would not restart-loop. But a JVM that dies of a real fault also
# exits 1, so the same rule recorded genuine crashes as clean stops: the unit
# went inactive with Result=success, Restart=on-failure never fired, and
# `systemctl is-failed minecraft` reported nothing wrong. Anything watching the
# unit — a monitoring probe, a config-management run, an operator reading
# `systemctl status` — was told the server had stopped on purpose.
#
# start.sh now exits 78 (EX_CONFIG, sysexits(3)) for operator-fixable problems,
# so the two cases are distinguishable:
#
#   exit 0    clean shutdown            → inactive, no restart
#   exit 78   misconfiguration          → failed, NOT restarted (see below)
#   anything  crash, OOM-kill, JVM abort → failed, restarted after RestartSec
#
# 78 still marks the unit failed, which is the point: the problem is real and
# should be visible to `systemctl status`. RestartPreventExitStatus is what
# stops it from looping every 10 s over something no restart can fix.
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
