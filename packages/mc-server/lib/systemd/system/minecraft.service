[Unit]
Description=Minecraft Server
After=network.target
Documentation=https://apt.bulmer.dev

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft

# ── Hardening ──────────────────────────────────────────────────────────────
# The server already runs as the unprivileged 'minecraft' user (above). These
# directives stop a compromised JVM or mod from regaining privileges or
# touching anything outside the server's own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/minecraft
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NOTE: MemoryDenyWriteExecute is intentionally omitted — the JVM's JIT needs
# writable+executable pages and would fail to start under it.

ExecStart=/usr/lib/mc/start.sh
ExecStop=/usr/lib/mc/stop.sh
ExecReload=/usr/lib/mc/reload.sh

# Allow up to 5 min 30 s for the graceful shutdown sequence (5-min countdown
# + 30 s buffer) before systemd sends SIGKILL.
TimeoutStopSec=330s
TimeoutStartSec=60s

# Only kill the main process; ExecStop handles the rest.
KillMode=process

SuccessExitStatus=0 1
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=0

[Install]
WantedBy=multi-user.target
