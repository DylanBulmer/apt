# bash completion for mc (mc-server / mc-rcon)
#
# This lives in /etc/bash_completion.d rather than the modern lazy-loaded
# /usr/share/bash-completion/completions/ because the bash-completion package
# already owns the file "completions/mc" (Midnight Commander). The lookup key
# there is the command name, so there is no non-conflicting filename we could
# use — two packages shipping a command called "mc" cannot both claim it, and
# dpkg aborts the unpack rather than let us overwrite it.
#
# The compat dir is sourced eagerly at shell start, before anything triggers a
# dynamic load, so the completion registered here wins for the "mc" command.

_mc() {
    local cur prev words cword
    _init_completion || return

    local commands="install upgrade start stop restart status backup restore logs delete help"

    # Pick up plugin-provided commands (e.g. mc-rcon adds 'rcon') using the same
    # source of truth /usr/bin/mc dispatches from: the mc_register_command
    # declarations in /usr/lib/mc/commands.d/*.sh. Scanning for `cmd_*` instead
    # would offer completions for internal helpers the dispatcher now rejects.
    local plugin_dir="/usr/lib/mc/commands.d" f
    if [[ -d "$plugin_dir" ]]; then
        for f in "$plugin_dir"/*.sh; do
            [[ -f "$f" ]] || continue
            commands+=" $(sed -n 's/^[[:space:]]*mc_register_command[[:space:]]\{1,\}//p' "$f")"
        done
    fi

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return
    fi

    case "${words[1]}" in
        install|upgrade)
            case "$prev" in
                --type)
                    COMPREPLY=( $(compgen -W "vanilla paper fabric neoforge" -- "$cur") )
                    return
                    ;;
                --version)
                    return
                    ;;
            esac
            COMPREPLY=( $(compgen -W "--type --version --accept-eula --yes -y --force" -- "$cur")
                        $(compgen -f -X '!*.mrpack' -- "$cur") )
            ;;
        start|restart)
            COMPREPLY=( $(compgen -W "--accept-eula" -- "$cur") )
            ;;
        restore)
            local backups=()
            if [[ -d /var/backups/minecraft ]]; then
                backups=(/var/backups/minecraft/minecraft-*.tar.gz)
                [[ -e ${backups[0]} ]] || backups=()
            fi
            COMPREPLY=( $(compgen -W "${backups[*]}" -- "$cur") )
            ;;
    esac
} &&
    complete -F _mc mc
