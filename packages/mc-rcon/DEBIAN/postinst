#!/bin/bash
# When mc-rcon is installed, automatically enable RCON for the managed server.
# Generates a password if one does not already exist.
set -e

MC_CONFIG="/etc/minecraft"
SERVER_CONF="$MC_CONFIG/server.conf"
PASSWD_FILE="$MC_CONFIG/server.passwd"
SERVER_DIR="/opt/minecraft"
MC_USER="minecraft"

case "$1" in
    configure)
        # Nothing to do unless mc-server is also installed.
        [[ -f "$SERVER_CONF" ]] || exit 0

        # Source config to get SERVER_PORT
        SERVER_PORT="25565"
        source "$SERVER_CONF" 2>/dev/null || true
        RCON_PORT=$((SERVER_PORT + 10))

        # Generate password if not present
        if [[ ! -f "$PASSWD_FILE" ]]; then
            head -c 24 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=' > "$PASSWD_FILE"
            chmod 640 "$PASSWD_FILE"
            chown root:"$MC_USER" "$PASSWD_FILE"
        fi

        PASSWORD=$(cat "$PASSWD_FILE")

        # Enable RCON in server.properties
        PROPS="$SERVER_DIR/server.properties"
        SETTINGS_CHANGED=no
        if [[ -f "$PROPS" ]]; then
            # Set a property to a value, reporting whether it actually moved.
            # The restart below is gated on this: reconfiguring a server that
            # already has these exact values is pure downtime, and on a
            # populated server stop.sh spends five minutes counting players
            # down before it goes. An unattended `apt upgrade` that happens to
            # pull a new mc-rcon must not cost that for a no-op.
            set_prop() {
                local key="$1" value="$2" current
                if grep -q "^${key}=" "$PROPS"; then
                    current=$(sed -n "s|^${key}=||p" "$PROPS" | head -1)
                    [[ "$current" == "$value" ]] && return 0
                    # '|' is the sed delimiter here and the password charset is
                    # base64url (A-Za-z0-9-_), so no value reaching this can
                    # contain one. Ports and 'true' are likewise safe.
                    sed -i "s|^${key}=.*|${key}=${value}|" "$PROPS"
                else
                    echo "${key}=${value}" >> "$PROPS"
                fi
                SETTINGS_CHANGED=yes
            }

            set_prop enable-rcon   "true"
            set_prop rcon.port     "$RCON_PORT"
            set_prop rcon.password "$PASSWORD"

            chown "$MC_USER:$MC_USER" "$PROPS"
            # This file now holds the RCON password. 0644 (the default from the
            # umask under which it was created) exposed that secret to every
            # local user, who could then drive the server console over loopback.
            chmod 640 "$PROPS"
        fi

        # Restart only if something above actually changed — see set_prop.
        if [[ "$SETTINGS_CHANGED" == "yes" ]] \
                && command -v systemctl &>/dev/null \
                && systemctl is-active --quiet minecraft 2>/dev/null; then
            echo "mc-rcon: restarting minecraft service to apply RCON settings..."
            systemctl restart minecraft || true
        fi
        ;;
esac

exit 0
