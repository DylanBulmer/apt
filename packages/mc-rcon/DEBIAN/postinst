#!/bin/bash
# When mc-rcon is installed, make sure the RCON password exists and enable RCON
# on the managed server.
set -e

LIB_SH="/usr/lib/mc/lib.sh"

case "$1" in
    configure)
        # Everything below comes from mc-server, which Depends: guarantees is
        # unpacked and configured before this runs. Sourcing it, rather than
        # restating the paths and the property writes, is what keeps this script
        # from drifting away from the CLI.
        #
        # THE VERSIONED Depends: IN control IS LOAD-BEARING, not decoration.
        # This file calls shell functions out of another package's private
        # library, so "mc-server is installed" is not a strong enough claim — it
        # has to be a version whose library defines them, or dpkg configures
        # this against an older one and the script dies with `command not found`
        # (exit 127), leaving mc-rcon half-installed. Raise the floor whenever
        # this script starts using a function that older mc-server versions do
        # not export.
        [[ -r "$LIB_SH" ]] || exit 0
        # shellcheck source=/usr/lib/mc/lib.sh
        source "$LIB_SH"

        # Unconditional, and ahead of the server check: the password should
        # exist from the moment the client is installed, whether or not a server
        # has been created yet. `mc install` calls this too, so a server created
        # later is provisioned either way.
        ensure_rcon_password

        # No server yet — nothing to enable on. mc install applies the rest.
        [[ -f "$SERVER_CONF" ]] || exit 0

        load_config

        # Restart only if something actually moved. Reconfiguring a server that
        # already has these exact values is pure downtime, and on a populated
        # server stop.sh spends five minutes counting players down before it
        # goes. An unattended `apt upgrade` that happens to pull a new mc-rcon
        # must not cost that for a no-op.
        if set_rcon_enabled true; then
            if command -v systemctl >/dev/null 2>&1 \
                    && systemctl is-active --quiet minecraft 2>/dev/null; then
                echo "mc-rcon: restarting minecraft service to apply RCON settings..."
                systemctl restart minecraft || true
            fi
        fi
        ;;
esac

exit 0
