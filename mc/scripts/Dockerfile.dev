# Interactive test environment for mc packages.
#
# Build context is mc/ (the workspace root), so all COPY paths are relative to that.

FROM debian:13-slim

# Runtime deps
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
        ca-certificates sudo zip bash-completion \
        openjdk-21-jre-headless openjdk-25-jre-headless \
 && rm -rf /var/lib/apt/lists/*

# systemctl stub so mc thinks systemd is present
COPY tests/systemctl-stub /usr/local/bin/systemctl
RUN chmod 755 /usr/local/bin/systemctl \
 && mkdir -p /run/systemd/system

# Install the packages (core first, then plugins)
COPY dist/mc-server_*.deb /tmp/
RUN dpkg -i /tmp/mc-server_*.deb

COPY dist/mc-rcon_*.deb dist/mc-mgmt_*.deb dist/mc-backup_*.deb dist/mc-mrpack_*.deb /tmp/
RUN dpkg -i /tmp/mc-rcon_*.deb /tmp/mc-mgmt_*.deb /tmp/mc-backup_*.deb /tmp/mc-mrpack_*.deb \
 && rm -f /tmp/*.deb

# Root password so `su` and `sudo` work interactively
RUN echo 'root:root' | chpasswd

# Generate completions with all plugins and install them
RUN mc completions bash > /usr/share/bash-completion/completions/mc-server

# Source bash-completion for interactive shells
RUN echo 'source /usr/share/bash-completion/bash_completion' >> /root/.bashrc

WORKDIR /root
CMD ["bash"]